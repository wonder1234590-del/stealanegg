* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

html,
body {
    margin: 0;
    padding: 0;
    min-height: 100%;
}

body {
    background: #080a0f;
    color: #ffffff;
    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Arial,
        sans-serif;

    padding-bottom: 90px;
}


/* =========================
   TOP BAR
========================= */

.topbar {
    position: sticky;
    top: 0;
    z-index: 50;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 13px 15px;

    background: rgba(12, 15, 21, 0.96);
    border-bottom: 1px solid #202532;

    backdrop-filter: blur(16px);
}

.brand-title {
    font-size: 16px;
    font-weight: 900;
    letter-spacing: 0.4px;
}

.brand-subtitle {
    margin-top: 2px;
    font-size: 11px;
    color: #858da0;
}

.top-actions {
    display: flex;
    align-items: center;
    gap: 7px;
}

.balance-button,
.support-button {
    border: 0;
    color: #ffffff;
    cursor: pointer;

    transition:
        transform 0.15s ease,
        opacity 0.15s ease;
}

.balance-button:active,
.support-button:active,
button:active {
    transform: scale(0.96);
}

.balance-button {
    padding: 9px 12px;

    background: #191e28;

    border: 1px solid #292f3b;
    border-radius: 13px;

    font-size: 14px;
    font-weight: 800;
}

.support-button {
    width: 38px;
    height: 38px;

    background: #143925;

    border: 1px solid #245c3d;
    border-radius: 13px;

    color: #63e59a;
    font-size: 18px;
    font-weight: 900;
}


/* =========================
   MAIN
========================= */

main {
    width: 100%;
    max-width: 760px;

    margin: 0 auto;
    padding: 16px;
}

.page-title {
    margin: 4px 0 5px;

    font-size: 25px;
    font-weight: 900;
}

.page-subtitle {
    margin-bottom: 18px;

    color: #8b93a5;
    font-size: 13px;
}


/* =========================
   SEARCH
========================= */

.search-box {
    width: 100%;

    padding: 13px 14px;

    margin-bottom: 12px;

    background: #12161e;

    border: 1px solid #272d39;
    border-radius: 14px;

    color: white;

    outline: none;

    font-size: 14px;
}

.search-box:focus {
    border-color: #596274;
}


/* =========================
   FILTERS
========================= */

.filters {
    display: flex;
    gap: 8px;

    overflow-x: auto;

    padding-bottom: 4px;
    margin-bottom: 14px;

    scrollbar-width: none;
}

.filters::-webkit-scrollbar {
    display: none;
}

.filter-button {
    flex: 0 0 auto;

    padding: 9px 13px;

    background: #151a23;

    border: 1px solid #292f3b;
    border-radius: 12px;

    color: #aeb6c6;

    font-weight: 700;
}

.filter-button.active {
    background: #ffffff;
    color: #090b10;

    border-color: #ffffff;
}


/* =========================
   CARDS
========================= */

.card {
    margin-bottom: 12px;
    padding: 15px;

    background: #11151d;

    border: 1px solid #252b37;
    border-radius: 17px;
}

.card-title {
    margin: 0 0 7px;

    font-size: 17px;
    font-weight: 850;
}

.card-text {
    color: #9aa2b2;

    font-size: 13px;
    line-height: 1.5;
}

.card-row {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 10px;
}


/* =========================
   PRODUCT
========================= */

.product-game {
    color: #8f98aa;
    font-size: 12px;
}

.product-price {
    color: #ffffff;

    font-size: 19px;
    font-weight: 900;
}

.product-seller {
    margin-top: 10px;

    color: #7f8797;

    font-size: 12px;
}

.product-description {
    margin-top: 10px;

    color: #b0b7c5;

    font-size: 13px;
    line-height: 1.5;
}


/* =========================
   BUTTONS
========================= */

.primary-button,
.secondary-button,
.danger-button {
    width: 100%;

    padding: 13px 15px;

    border: 0;
    border-radius: 13px;

    cursor: pointer;

    font-size: 14px;
    font-weight: 800;
}

.primary-button {
    margin-top: 12px;

    background: #ffffff;
    color: #080a0f;
}

.secondary-button {
    margin-top: 8px;

    background: #1b202a;
    color: #ffffff;

    border: 1px solid #2a303c;
}

.danger-button {
    margin-top: 8px;

    background: #3d1c22;
    color: #ff8998;

    border: 1px solid #64303a;
}


/* =========================
   INPUTS
========================= */

.input,
.textarea,
.select {
    width: 100%;

    padding: 13px;

    margin-top: 8px;

    background: #11161e;

    border: 1px solid #292f3b;
    border-radius: 13px;

    color: #ffffff;

    outline: none;

    font-size: 14px;
}

.input:focus,
.textarea:focus,
.select:focus {
    border-color: #626c80;
}

.textarea {
    min-height: 110px;

    resize: vertical;
}


/* =========================
   SELL FORM
========================= */

.game-selector {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 8px;

    margin-top: 10px;
}

.game-button {
    padding: 12px;

    background: #151a22;

    border: 1px solid #292f3b;
    border-radius: 13px;

    color: #9da5b5;

    font-weight: 800;
}

.game-button.active {
    background: #ffffff;
    color: #080a0f;

    border-color: #ffffff;
}


/* =========================
   ORDERS
========================= */

.status {
    display: inline-flex;

    padding: 6px 9px;

    margin-top: 9px;

    background: #1b212c;

    border-radius: 9px;

    color: #aeb7c7;

    font-size: 11px;
    font-weight: 700;
}

.status.waiting {
    background: #342d18;
    color: #f1d36b;
}

.status.completed {
    background: #163b29;
    color: #65e59b;
}

.status.dispute {
    background: #3c1c22;
    color: #ff8997;
}


/* =========================
   CHAT
========================= */

.message {
    padding: 11px 13px;

    margin: 7px 0;

    border-radius: 13px;

    background: #191e28;
}

.message.mine {
    background: #ffffff;
    color: #0a0c10;
}

.message-author {
    margin-bottom: 4px;

    font-size: 11px;
    font-weight: 800;
}

.message-text {
    font-size: 14px;
    line-height: 1.45;
}


/* =========================
   PROFILE
========================= */

.profile-avatar {
    width: 64px;
    height: 64px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: 12px;

    background: #202631;

    border-radius: 50%;

    font-size: 27px;
}

.profile-name {
    font-size: 20px;
    font-weight: 900;
}

.profile-id {
    margin-top: 3px;

    color: #858d9e;

    font-size: 12px;
}

.stats {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 8px;

    margin-top: 15px;
}

.stat {
    padding: 12px 8px;

    background: #181d26;

    border-radius: 13px;

    text-align: center;
}

.stat-number {
    font-size: 18px;
    font-weight: 900;
}

.stat-label {
    margin-top: 4px;

    color: #858e9e;

    font-size: 10px;
}


/* =========================
   EMPTY
========================= */

.empty {
    padding: 45px 20px;

    text-align: center;

    color: #858d9d;
}

.empty-icon {
    margin-bottom: 10px;

    font-size: 35px;
}

.empty-title {
    color: #ffffff;

    font-weight: 800;
}


/* =========================
   TOAST
========================= */

#toast-container {
    position: fixed;

    left: 15px;
    right: 15px;
    bottom: 82px;

    z-index: 100;

    pointer-events: none;
}

.toast {
    max-width: 500px;

    margin: 7px auto;

    padding: 12px 14px;

    background: #1b202a;

    border: 1px solid #303746;
    border-radius: 13px;

    color: white;

    box-shadow: 0 8px 30px rgba(0,0,0,.35);

    font-size: 13px;

    animation: toast-in .2s ease;
}

@keyframes toast-in {
    from {
        opacity: 0;
        transform: translateY(8px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}


/* =========================
   BOTTOM NAV
========================= */

.bottom-nav {
    position: fixed;

    left: 0;
    right: 0;
    bottom: 0;

    z-index: 50;

    display: grid;

    grid-template-columns: repeat(4, 1fr);

    height: 72px;

    padding: 7px 8px calc(7px + env(safe-area-inset-bottom));

    background: rgba(12, 15, 21, .97);

    border-top: 1px solid #222833;

    backdrop-filter: blur(18px);
}

.nav-button {
    display: flex;

    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 3px;

    border: 0;

    background: transparent;

    color: #737c8d;

    font-size: 10px;
    font-weight: 700;
}

.nav-icon {
    font-size: 20px;
}

.nav-button.active {
    color: #ffffff;
}


/* =========================
   NOTICE
========================= */

.notice {
    padding: 12px 13px;

    margin-bottom: 12px;

    background: #172a20;

    border: 1px solid #24563a;
    border-radius: 13px;

    color: #7fe5a4;

    font-size: 13px;
}


/* =========================
   RESPONSIVE
========================= */

@media (min-width: 700px) {

    .bottom-nav {
        left: 50%;
        right: auto;

        width: 600px;

        transform: translateX(-50%);

        border-left: 1px solid #222833;
        border-right: 1px solid #222833;

        border-radius: 18px 18px 0 0;
    }

}
